{
  "name": "friend-finder",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @repo/web build",
    "dev": "pnpm --filter @repo/web dev",
    "web": "pnpm --filter @repo/web dev",
    "mobile": "pnpm --filter @repo/mobile start",
    "ios": "pnpm --filter @repo/mobile ios",
    "android": "pnpm --filter @repo/mobile android",
    "dev:all": "concurrently \"pnpm run dev\" \"pnpm run mobile\""
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "pnpm": {
    "overrides": {
      "react-native-screens": "4.16.0"
    }
  },
  "packageManager": "pnpm@10.28.2+sha512.41872f037ad22f7348e3b1debbaf7e867cfd448f2726d9cf74c08f19507c31d2c8e7a11525b983febc2df640b5438dee6023ebb1f84ed43cc2d654d2bc326264"
}
