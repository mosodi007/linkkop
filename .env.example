# Supabase (required for auth and database)
# Get these from your project: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Resend (for sign-up confirmation emails via Supabase SMTP). Create at https://resend.com/api-keys
RESEND_API_KEY=your-resend-api-key
